# Copy to .env (never commit .env).
# MongoDB local service from dragons_project_nlp (host machine)
MONGODB_URI=mongodb://root:dragons_dev_password@localhost:50030/?authSource=admin
# When this ETL runs inside the shared Docker network use:
# MONGODB_URI=mongodb://root:dragons_dev_password@dragons-mongo:27017/?authSource=admin
MONGODB_DATABASE=dragons

# Google BigQuery service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Bluesky public post search. Use an App Password, not the account password.
# BLUESKY_IDENTIFIER=your-handle.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Threads Graph API keyword search token.
# THREADS_APP_ID=your-threads-app-id
# THREADS_APP_SECRET=your-threads-app-secret
# THREADS_ACCESS_TOKEN=your-threads-access-token
